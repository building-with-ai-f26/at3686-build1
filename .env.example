# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# Optional free Bargo key (https://www.bargo.ai/free-apis/dash) for the Congress
# trades summary script: node --env-file=.env scripts/update-congress-summary.mjs
# In GitHub, store it as the repository secret BARGO_API_KEY. Never put it in the page.
BARGO_API_KEY=replace-with-your-bargo-key
